# ---------------------------------------------------------------------------
# TradeOS environment template. Copy to `.env` and fill in values. Never commit
# real secrets. Provider credentials (Upstox) belong to the backend only and
# are never exposed to the browser.
# ---------------------------------------------------------------------------

# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_APP_NAME=TradeOS
VITE_PUBLIC_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1
# Market data source for the frontend: `http` (backend REST, phase 2+) or
# `mock` (deterministic simulated adapter, development/tests only).
VITE_MARKET_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Backend (NestJS). Read by `backend/` at boot and validated with Zod.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# PostgreSQL. Optional in development (in-memory metadata repository is used
# when absent); required in production.
# DATABASE_URL=postgresql://tradeos:tradeos@localhost:5432/tradeos
# Market-data provider: `mock` (deterministic simulated data, refused in
# production) or `upstox` (adapter lands in phase 3).
MARKET_DATA_PROVIDER=mock
# Realtime-state TTL for an assembled option-chain snapshot (seconds).
OPTION_CHAIN_SNAPSHOT_TTL_SECONDS=2
# Seconds before expiries/contracts are re-validated with the provider.
OPTION_METADATA_TTL_SECONDS=900
# Global REST rate limit per client.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# OpenAPI UI at /api/docs (never served in production).
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Realtime (phase 3)
# ---------------------------------------------------------------------------
# Redis: optional. Absent → single-instance mode (in-process state, bus, lease).
# REDIS_URL=redis://localhost:6379
# HS256 secret (≥32 chars) for /ws/market session tokens. Required in production;
# a per-process secret is generated in development when absent.
# REALTIME_JWT_SECRET=
REALTIME_TOKEN_TTL_SECONDS=900
# Application WebSocket limits and cadence.
WS_MAX_CONNECTIONS=500
WS_MAX_CONNECTIONS_PER_IP=10
WS_MAX_SUBSCRIPTIONS_PER_CLIENT=600
WS_MAX_MESSAGE_BYTES=16384
WS_MESSAGES_PER_SECOND=20
WS_FLUSH_INTERVAL_MS=100
# Upstream feed watchdog.
FEED_STALE_AFTER_MS=15000
FEED_CONNECT_TIMEOUT_MS=10000
# Operator key (≥24 chars) protecting /api/v1/providers/upstox/auth/*. Required in production.
# OPERATOR_API_KEY=
# AES-256-GCM key (base64, 32 bytes) for provider credentials at rest. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Upstox (MARKET_DATA_PROVIDER=upstox). Server-side only; never shipped to the browser.
# ---------------------------------------------------------------------------
# Either a daily/long-lived access token …
# UPSTOX_ACCESS_TOKEN=
# … or OAuth 2.0 app credentials for the operator login flow.
# UPSTOX_CLIENT_ID=
# UPSTOX_CLIENT_SECRET=
# UPSTOX_REDIRECT_URI=https://your-host/api/v1/providers/upstox/auth/callback
UPSTOX_API_BASE_URL=https://api.upstox.com
# Feed mode (ltpc | option_greeks | full | full_d30) and upstream key cap for that mode.
UPSTOX_FEED_MODE=full
UPSTOX_MAX_SUBSCRIPTIONS=1500

# Frontend: market stream endpoint (path on the same origin, or an absolute ws(s) URL).
VITE_WS_URL=/ws/market

# ---------------------------------------------------------------------------
# Phase 4 — hardening
# ---------------------------------------------------------------------------
# Per-request access logs. Default: on in development, off in production (CPU).
# HTTP_REQUEST_LOGGING=false
# Honour X-Forwarded-For for rate limits / per-IP caps. Only behind a trusted proxy.
TRUST_PROXY=false
# PostgreSQL pool size (free tiers cap connections; 4 is plenty for metadata reads).
DATABASE_POOL_MAX=4
# Sentry (backend). Disabled when empty; events are scrubbed of tokens/headers/PII.
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Sentry (frontend, production builds only; SDK lazy-loaded).
# VITE_SENTRY_DSN=
# E2E-only build flag (never set for real deployments).
# VITE_E2E_HOOKS=false

# ---------------------------------------------------------------------------
# Foundation (0.5.0)
# ---------------------------------------------------------------------------
# Layered files are also read: .env.<NODE_ENV>.local, .env.local, .env.<NODE_ENV>, .env
# Swagger at /api/docs: default on outside production; set explicitly to enable in production.
# SWAGGER_ENABLED=false
