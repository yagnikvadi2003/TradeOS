# syntax=docker/dockerfile:1.7
# Small runtime image: production deps only, non-root, healthcheck on /health/live.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json backend/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @tradeos/backend...
COPY backend backend
RUN pnpm --filter @tradeos/backend prisma:generate && pnpm --filter @tradeos/backend build \
 && pnpm --filter @tradeos/backend --prod deploy /out

FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
WORKDIR /app
COPY --from=build /out /app
COPY --from=build /repo/backend/dist /app/dist
COPY --from=build /repo/backend/prisma /app/prisma
COPY --from=build /repo/backend/prisma.config.ts /app/prisma.config.ts
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD wget -qO- http://127.0.0.1:3000/health/live || exit 1
CMD ["node", "dist/main.js"]
