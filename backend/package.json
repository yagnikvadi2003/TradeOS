{
  "name": "@tradeos/backend",
  "version": "0.5.0",
  "private": true,
  "description": "TradeOS backend — NestJS REST API, option-chain domain, provider abstraction",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "test:unit": "vitest run --exclude \"**/*.api.test.ts\" --exclude \"**/*.gateway.test.ts\"",
    "test:integration": "vitest run api.test gateway.test",
    "test:coverage": "vitest run --coverage",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "openapi:export": "node scripts/export-openapi.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "protobufjs": "^7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.3",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.3",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
